# Copy to .env and fill in real values. NEVER commit the real .env.
# SQLite database (Prisma). Match the path style of the real deployment.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session signing secret (HMAC-SHA256 for auth cookies). REQUIRED — the app
# refuses to boot without it. Generate with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-32-bytes-hex

# Encryption secret for credentials at rest (per-user Alpaca keys, Telegram
# tokens, TOTP secrets — AES-256-GCM). REQUIRED (falls back to AUTH_SECRET).
APP_ENCRYPTION_SECRET=change-me-32-bytes-hex

# Permit new account creation via POST /api/auth/register (default: false —
# closed registration). A fresh install with an EMPTY user table can always
# create its FIRST account regardless of this flag (first-run bootstrap).
ALLOW_REGISTRATION=false

# Permit trading with the shared env-configured Alpaca keys when a user has no
# keys of their own (default: false).
ALLOW_SHARED_BROKER=false

# v2.12.52 — AI features (post-trade AI auditor, pre-trade veto gate,
# sentiment engine, rule consolidation) need NO env vars: they ride the
# platform's BUILT-IN AI config — the built-in EdgeZero lane by default, and
# each user's own endpoint once they save one under Settings → AI Agent API
# (endpoint + model + key, encrypted, with a built-in test button).
# Operators can still override the built-in lane endpoint/key (pre-existing
# vars, also used by the AI adviser chat):
#AI_TRADE_BASE_URL=
#AI_TRADE_API_KEY=

# NOTE (Task 9-j): these two secrets are OPTIONAL at boot. If absent (e.g. a
# sanitized publish environment), the app resolves a per-install master from
# the AppSecret DB table, generating one on first use. Env values always win
# and are mirrored to the DB so later sanitized boots keep the same key.
# Set them once and keep them stable — rotating after credentials are stored
# makes those rows undecryptable.

# Task 11-c — optional Prometheus scrape endpoint at GET /api/metrics.
# Off by default (404); set to 1 to expose uptime/memory/run-count gauges.
ENABLE_METRICS=0

# Task 11-c — structured JSON log level for src/lib/logger.ts ops events
# (auth failures, rate-limit fallbacks, health degradation).
LOG_LEVEL=info

# Task 11-d — docker only: allow DESTRUCTIVE prisma db push at container boot.
# Keep 0; flip to 1 only for a knowingly destructive schema change.
DB_PUSH_ACCEPT_DATA_LOSS=0
