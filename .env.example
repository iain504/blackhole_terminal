# Copy to .env and fill in real values. NEVER commit the real .env.
# SQLite database (Prisma). Match the path style of the real deployment.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session signing secret (HMAC-SHA256 for auth cookies). REQUIRED — the app
# refuses to boot without it. Generate with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-32-bytes-hex

# Encryption secret for credentials at rest (per-user Alpaca keys, Telegram
# tokens, TOTP secrets — AES-256-GCM). REQUIRED (falls back to AUTH_SECRET).
APP_ENCRYPTION_SECRET=change-me-32-bytes-hex

# Permit new account creation via POST /api/auth/register (default: false).
ALLOW_REGISTRATION=false

# Permit trading with the shared env-configured Alpaca keys when a user has no
# keys of their own (default: false).
ALLOW_SHARED_BROKER=false

# NOTE (Task 9-j): these two secrets are OPTIONAL at boot. If absent (e.g. a
# sanitized publish environment), the app resolves a per-install master from
# the AppSecret DB table, generating one on first use. Env values always win
# and are mirrored to the DB so later sanitized boots keep the same key.
# Set them once and keep them stable — rotating after credentials are stored
# makes those rows undecryptable.
