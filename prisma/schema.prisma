generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  totpSecret   String
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#22c55e")
  sortOrder Int      @default(0)
  items     Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Layout {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Drawing {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  kind      String
  points    Json
  color     String   @default("#2962ff")
  width     Int      @default(2)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, symbol])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  // kind: 'price' (legacy price alarm) | 'rsi' | 'macd' (indicator alarms)
  kind        String    @default("price")
  // price: the trigger level (price alerts) — for rsi: the 0-100 level,
  // for macd cross_above/cross_below: the macd-line level (0 = zero line)
  price       Float
  // 'above' | 'below' — crossing direction (macd crossovers map bull→above, bear→below)
  direction   String    @default("above")
  // macd conditions: 'bull_cross' (macd crosses above signal) | 'bear_cross' |
  // 'cross_above' | 'cross_below' (macd line vs `price` level). rsi/price: null
  condition   String?
  // bar timeframe the indicator is computed on (rsi/macd only): '1m'..'1M'
  timeframe   String    @default("1D")
  // indicator params: rsi {period} · macd {fast,slow,signal}
  params      Json?
  color       String    @default("#f59e0b")
  status      String    @default("active")
  note        String?
  // crossing memory: last side of the value vs the level ('above'/'below').
  // price alerts seed the opposite side (legacy behavior); indicator alerts
  // start null — the first check records the side WITHOUT triggering so only
  // genuine crossings fire
  lastSide    String?
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, status])
}

// Conditional ("complex") orders — the strategy bot: WHEN an indicator
// condition fires, place a market BUY/SELL with optional TP/SL (bracket).
// The condition half reuses the indicator-alarm semantics (crossing memory);
// the action half reuses the bracket plumbing (placeOrderWithExits).
model StrategyRule {
  id        String  @id @default(cuid())
  userId    String
  symbol    String
  // ---- condition: kind 'rsi' | 'macd' ----
  kind      String
  // rsi: 'cross_above'|'cross_below' (level 0-100);
  // macd: 'bull_cross'|'bear_cross'|'cross_above'|'cross_below' (line vs level)
  condition String
  level     Float
  // bar timeframe the indicator is computed on: '1m'..'1M'
  timeframe String  @default("1D")
  // rsi {period} · macd {fast,slow,signal}
  params    Json
  // ---- action ----
  action    String // 'buy' | 'sell'
  qty       Float
  // TP/SL: 'none' | 'price' (absolute) | 'pct' (PERCENT offset from the live
  // quote at fire time, 2 = 2% — applied on the profit side for TP and the
  // loss side for SL, relative to the action direction)
  tpMode    String  @default("none")
  tpValue   Float?
  slMode    String  @default("none")
  slValue   Float?
  // one-shot (status ends 'triggered') or repeat (re-arms with fresh crossing
  // memory after every fire)
  repeat    Boolean @default(false)
  // ---- state: armed | paused | placing | triggered | failed ----
  status    String  @default("armed")
  // crossing memory (same semantics as indicator alarms): null until the first
  // check records the side — only a genuine crossing afterwards fires
  lastSide  String?
  triggeredAt DateTime?
  orderId   String?
  // human message of the last fire (success detail or the broker error)
  fireNote  String?
  createdAt DateTime @default(now())

  @@index([userId, status])
}

// Append-only log of every strategy evaluation that FIRED (success or
// failure). Powers the Strategy Orders tab: per-rule fire history, the
// historical trades each fire produced (via its entry orderId) and the
// realized P&L attribution. Survives rule deletion (ruleId is a plain
// string, no relation) so history is never lost.
model StrategyFireLog {
  id        String   @id @default(cuid())
  userId    String
  ruleId    String
  symbol    String
  action    String // 'buy' | 'sell'
  qty       Float
  ok        Boolean
  message   String
  // entry order id of the placed order (success only) — the key used to
  // attribute the resulting round-trip trade(s) from the broker's closed
  // orders (FIFO matching)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId, ruleId])
  @@index([userId, createdAt])
}

// Economic-calendar event alarms. Events have no stable id upstream, so the
// key is "<ISO time>|<currency>|<title>" (same derivation on the client).
model CalendarAlarm {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([userId, eventKey])
  @@index([userId])
}

// Telegram order-fill / position-close notification watcher — one cursor per
// (user, mode). positions: snapshot of the open positions at the last cycle
// ({symbol: {side, qty, avgEntry}}) used to detect closures; seen: recently
// notified order ids (ring buffer, pruned after 24h) so restarts and overlaps
// never double-notify.
model NotifyState {
  userId    String
  mode      String
  lastRunAt DateTime @default(now())
  positions Json?
  seen      Json?

  @@id([userId, mode])
}

// Algo Trading (Task 61) — one row per strategy run. The engine loop
// (algo-engine.ts) re-reads the row every cycle, so the DB is the single
// source of truth: `state` carries the working memory (position tracking,
// day counters, OR range, VWAP accumulator, last evaluated bar) and survives
// dev-server restarts — runs with status 'running' are auto-resumed.
model AlgoRun {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  timeframe    String    @default("5m") // '1m' | '5m' | '15m'
  strategy     String // 'bb-reversion' | 'rsi2-connors' | 'orb15' | 'vwap-fade'
  params       Json
  qty          Float
  // Position sizing (Task 78 — "Risk Money"): 'fixed' trades `qty` units per
  // entry (legacy behavior) · 'risk' treats the risk budget as the DOLLARS AT
  // RISK per trade and derives the position size at entry time:
  //   qty = riskBudget / (entryPrice × slValue/100)
  // Risk sizing requires an SL % bracket — without one the engine falls back
  // to `qty` and journals why.
  sizingMode   String    @default("fixed")
  // Task 78e — how the Risk-Money budget is expressed: 'usd' = `riskMoney`
  // is a fixed dollar amount per trade · 'pct' = `riskMoneyPct` is a percent
  // of ACCOUNT EQUITY per trade, resolved to a dollar budget at each entry
  // (live: broker account equity · backtest: the simulated equity curve, so
  // risk compounds with the account). Null fields follow the basis.
  riskBasis    String    @default("usd")
  riskMoney    Float?
  riskMoneyPct Float?
  // exits: 'none' (strategy logic closes) | 'pct' (bracket % from entry)
  tpMode       String    @default("none")
  tpValue      Float?
  slMode       String    @default("none")
  slValue      Float?
  maxTradesDay Int       @default(3)
  rthOnly      Boolean   @default(true)
  flattenEod   Boolean   @default(true)
  // re-entry control (Task 70-c): cooldownMin = no new entries for N minutes
  // after the run's position closes (0 = off) · requireNewSignal = a signal may
  // only fire on a false→true edge vs the previously processed closed bar
  cooldownMin     Int     @default(0)
  requireNewSignal Boolean @default(false)
  // 'running' | 'stopped'
  status       String    @default("running")
  state        Json?
  startedAt    DateTime  @default(now())
  stoppedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}

// Append-only engine journal: cycle notes, signal detection, order results,
// errors. Powers the live log feed in the Algo tab.
model AlgoLog {
  id        String   @id @default(cuid())
  runId     String
  userId    String
  level     String   @default("info") // info | signal | trade | error
  message   String
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
  @@index([userId, createdAt])
}

// Task 3-d — local bar cache for CRYPTO history only (crypto bars are
// immutable once closed; stock bars are NOT cached here because Alpaca stock
// responses are split-adjusted and the adjustment basis can change over time).
// time = unix seconds, bar OPEN time (same convention as src/lib/market-types).
// Composite PK makes saveBars an idempotent upsert (INSERT OR REPLACE).
model Bar {
  symbol String
  tf     String
  time   Int
  open   Float
  high   Float
  low    Float
  close  Float
  volume Float

  @@id([symbol, tf, time])
  @@index([symbol, tf])
}

// Task 90 — cached output of the "Recommended setups" sweep matrix. One row
// (fixed id) holds the newest full-catalog sweep results as JSON; the Backtest
// page reads it via GET /api/algo/recommendations and a refresh POST rewrites
// it. Falls back to the baked-in static list when absent.
model AlgoRecoCache {
  id          String   @id @default("algo-reco")
  generatedAt DateTime
  payload     String
  updatedAt   DateTime @updatedAt
}

// Grid Trading — a range grid bot: buy dips at lower grid levels, sell the
// lots as price climbs to the next level. The engine loop (grid-engine.ts)
// re-reads the row every cycle — the DB is the single source of truth and
// grids with status 'active' auto-resume after a server restart (same model
// as AlgoRun).
model GridTrade {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  // ---- range ----
  lowerPrice  Float
  upperPrice  Float
  gridCount   Int // number of grid levels (2..200)
  // 'arithmetic' (evenly spaced) | 'geometric' (equal ratio)
  spacing     String    @default("arithmetic")
  // ---- sizing ----
  qtyPerGrid  Float
  // ---- whole-grid guards (optional) ----
  maxSL       Float? // price falls here → close everything + stop (hard floor)
  maxTP       Float? // price rises here → close everything + stop (profit ceiling)
  // Task 10-a — how the guard values are expressed: 'price' = maxSL/maxTP are
  // absolute prices (must order strictly outside the range) · 'percent' =
  // maxSL/maxTP are percentages: slTrigger = lowerPrice × (1 − maxSL/100),
  // tpTrigger = upperPrice × (1 + maxTP/100) — resolved EVERY engine tick so a
  // later config edit (PUT /api/grid/[id]) re-arms the guards automatically.
  slBasis     String    @default("price")
  tpBasis     String    @default("price")
  // when the grid stops (manual or guard), market-close open grid positions
  closeOnStop Boolean   @default(true)
  // 'active' | 'stopped' | 'error'
  status      String    @default("active")
  stopReason  String?
  // engine-maintained cached stats (recomputable from fills)
  realizedPnl Float     @default(0)
  feePaid     Float     @default(0)
  // working memory: levels snapshot + open lots — survives restarts
  state       Json?
  startedAt   DateTime  @default(now())
  stoppedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

// One executed grid order (buy at a level, sell/TP of a lot, or a
// stop/guard close). Append-only, like StrategyFireLog.
model GridFill {
  id          String   @id @default(cuid())
  gridTradeId String
  userId      String
  levelIndex  Int
  side        String // 'buy' | 'sell'
  reason      String   @default("grid") // 'grid' | 'tp' | 'sl' | 'maxtp' | 'manual_close'
  price       Float
  qty         Float
  pnl         Float? // realized P&L on sells (vs the paired buy lot)
  fee         Float    @default(0)
  orderId     String?
  note        String?
  ts          DateTime @default(now())

  @@index([gridTradeId, ts])
  @@index([userId])
}

// Task 9-j — per-install master secret store. The platform publish pipeline
// sanitizes secret lines out of .env; this row (created at boot when env is
// absent) keeps the install bootable while never using a publicly-known
// constant. Env (APP_ENCRYPTION_SECRET || AUTH_SECRET) always wins and is
// mirrored here so later sanitized boots resolve the SAME key.
model AppSecret {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
