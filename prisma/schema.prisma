generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  totpSecret   String
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#22c55e")
  sortOrder Int      @default(0)
  items     Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Layout {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// v2.9.3 — device awareness: one row per (account, browser). The deviceId is a
// client-generated persistent UUID (localStorage) — browsers never expose MAC
// addresses, so this + a UA-derived friendly name (editable) is the identity.
// currentTab/openTabs are the LIVE tab state reported by the 30s heartbeat.
model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  name       String
  kind       String   @default("desktop") // desktop | tablet | mobile
  ua         String?
  currentTab String?
  openTabs   Json?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
}

model Drawing {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  kind      String
  points    Json
  color     String   @default("#2962ff")
  width     Int      @default(2)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, symbol])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  // kind: 'price' (legacy price alarm) | 'rsi' | 'macd' (indicator alarms)
  kind        String    @default("price")
  // price: the trigger level (price alerts) — for rsi: the 0-100 level,
  // for macd cross_above/cross_below: the macd-line level (0 = zero line)
  price       Float
  // 'above' | 'below' — crossing direction (macd crossovers map bull→above, bear→below)
  direction   String    @default("above")
  // macd conditions: 'bull_cross' (macd crosses above signal) | 'bear_cross' |
  // 'cross_above' | 'cross_below' (macd line vs `price` level). rsi/price: null
  condition   String?
  // bar timeframe the indicator is computed on (rsi/macd only): '1m'..'1M'
  timeframe   String    @default("1D")
  // indicator params: rsi {period} · macd {fast,slow,signal}
  params      Json?
  color       String    @default("#f59e0b")
  status      String    @default("active")
  note        String?
  // crossing memory: last side of the value vs the level ('above'/'below').
  // price alerts seed the opposite side (legacy behavior); indicator alerts
  // start null — the first check records the side WITHOUT triggering so only
  // genuine crossings fire
  lastSide    String?
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, status])
}

// Conditional ("complex") orders — the strategy bot: WHEN an indicator
// condition fires, place a market BUY/SELL with optional TP/SL (bracket).
// The condition half reuses the indicator-alarm semantics (crossing memory);
// the action half reuses the bracket plumbing (placeOrderWithExits).
model StrategyRule {
  id        String  @id @default(cuid())
  userId    String
  symbol    String
  // Task 89 — the Alpaca account this rule fires on, PINNED at create time.
  // Rules are refused in live mode at create (mirrors grid/algo), so every
  // row is 'paper' — the column exists so a running rule can NEVER silently
  // follow a later Settings → tradeMode flip onto the other account.
  mode      String  @default("paper") // 'paper' | 'live'
  // ---- condition: kind 'rsi' | 'macd' ----
  kind      String
  // rsi: 'cross_above'|'cross_below' (level 0-100);
  // macd: 'bull_cross'|'bear_cross'|'cross_above'|'cross_below' (line vs level)
  condition String
  level     Float
  // bar timeframe the indicator is computed on: '1m'..'1M'
  timeframe String  @default("1D")
  // rsi {period} · macd {fast,slow,signal}
  params    Json
  // ---- action ----
  action    String // 'buy' | 'sell'
  qty       Float
  // TP/SL: 'none' | 'price' (absolute) | 'pct' (PERCENT offset from the live
  // quote at fire time, 2 = 2% — applied on the profit side for TP and the
  // loss side for SL, relative to the action direction) | 'atr' (v1.96.0:
  // tpValue/slValue is a MULTIPLIER 0.1–20 of Wilder ATR(14) on tpTf/slTf,
  // distance from the live quote at fire time — volatility-scaled stop)
  tpMode    String  @default("none")
  tpValue   Float?
  slMode    String  @default("none")
  slValue   Float?
  // ATR timeframe for mode 'atr' (a Timeframe key: '1m'..'1M'); null = N/A
  tpTf      String?
  slTf      String?
  // one-shot (status ends 'triggered') or repeat (re-arms with fresh crossing
  // memory after every fire)
  repeat    Boolean @default(false)
  // ---- state: armed | paused | placing | triggered | failed ----
  status    String  @default("armed")
  // crossing memory (same semantics as indicator alarms): null until the first
  // check records the side — only a genuine crossing afterwards fires
  lastSide  String?
  triggeredAt DateTime?
  orderId   String?
  // human message of the last fire (success detail or the broker error)
  fireNote  String?
  createdAt DateTime @default(now())

  @@index([userId, status])
}

// Append-only log of every strategy evaluation that FIRED (success or
// failure). Powers the Strategy Orders tab: per-rule fire history, the
// historical trades each fire produced (via its entry orderId) and the
// realized P&L attribution. Survives rule deletion (ruleId is a plain
// string, no relation) so history is never lost.
model StrategyFireLog {
  id        String   @id @default(cuid())
  userId    String
  ruleId    String
  symbol    String
  action    String // 'buy' | 'sell'
  qty       Float
  ok        Boolean
  message   String
  // Task 94 — the PINNED account the fire traded on ('paper' | 'live').
  // Rules can MOVE accounts (live opt-in PATCH), so attribution uses the
  // FIRE's mode, not the rule's current one — pre-move history would
  // otherwise orphan against the wrong broker tape. Legacy rows default
  // 'paper', which is correct (live rules could not exist before).
  mode      String   @default("paper")
  // entry order id of the placed order (success only) — the key used to
  // attribute the resulting round-trip trade(s) from the broker's closed
  // orders (FIFO matching)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId, ruleId])
  @@index([userId, createdAt])
  // v2.11.3 — index-backed retention prune (runDbMaintenance scans by createdAt)
  @@index([createdAt])
}

// Economic-calendar event alarms. Events have no stable id upstream, so the
// key is "<ISO time>|<currency>|<title>" (same derivation on the client).
model CalendarAlarm {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([userId, eventKey])
  @@index([userId])
}

// Task 31 — Economic Calendar filter preferences, ONE row per user (same
// shape as Layout): the Importance (High/Medium/Low) and Country filter
// choices the user made are stored so they survive reloads and follow the
// account across devices. Both columns hold JSON string arrays. The client
// also mirrors them into localStorage for an instant pre-auth paint.
model CalendarFilterPref {
  userId            String   @id
  imp               String   // JSON array of enabled importance levels (subset of high|medium|low)
  countryExclusions String   // JSON array of EXCLUDED country/currency codes — everything else shows
  updatedAt         DateTime @updatedAt
}

// Telegram order-fill / position-close notification watcher — one cursor per
// (user, mode). positions: snapshot of the open positions at the last cycle
// ({symbol: {side, qty, avgEntry}}) used to detect closures; seen: recently
// notified order ids (ring buffer, pruned after 24h) so restarts and overlaps
// never double-notify.
model NotifyState {
  userId    String
  mode      String
  lastRunAt DateTime @default(now())
  positions Json?
  seen      Json?

  @@id([userId, mode])
}

// Algo Trading (Task 61) — one row per strategy run. The engine loop
// (algo-engine.ts) re-reads the row every cycle, so the DB is the single
// source of truth: `state` carries the working memory (position tracking,
// day counters, OR range, VWAP accumulator, last evaluated bar) and survives
// dev-server restarts — runs with status 'running' are auto-resumed.
model AlgoRun {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  // Task 89 — the Alpaca account this run trades on, PINNED at start time
  // (algos refuse to start in live mode, so every row is 'paper'). The engine
  // orders against THIS mode forever — a later Settings → tradeMode flip
  // never migrates a running bot to the other account.
  mode         String    @default("paper") // 'paper' | 'live'
  timeframe    String    @default("5m") // '1m' | '5m' | '15m'
  strategy     String // 'bb-reversion' | 'rsi2-connors' | 'orb15' | 'vwap-fade'
  params       Json
  qty          Float
  // Position sizing (Task 78 — "Risk Money"): 'fixed' trades `qty` units per
  // entry (legacy behavior) · 'risk' treats the risk budget as the DOLLARS AT
  // RISK per trade and derives the position size at entry time:
  //   qty = riskBudget / (entryPrice × slValue/100)
  // Risk sizing requires an SL % bracket — without one the engine falls back
  // to `qty` and journals why.
  sizingMode   String    @default("fixed")
  // Task 78e — how the Risk-Money budget is expressed: 'usd' = `riskMoney`
  // is a fixed dollar amount per trade · 'pct' = `riskMoneyPct` is a percent
  // of ACCOUNT EQUITY per trade, resolved to a dollar budget at each entry
  // (live: broker account equity · backtest: the simulated equity curve, so
  // risk compounds with the account). Null fields follow the basis.
  riskBasis    String    @default("usd")
  riskMoney    Float?
  riskMoneyPct Float?
  // exits: 'none' (strategy logic closes) | 'pct' (bracket % from entry) |
  // 'atr' (v1.96.0: tpValue/slValue = ATR(14) multiplier 0.1–20 on tpTf/slTf —
  // bracket distance = mult × ATR from the entry anchor, resolved at entry)
  tpMode       String    @default("none")
  tpValue      Float?
  slMode       String    @default("none")
  slValue      Float?
  // ATR timeframe for mode 'atr' (a Timeframe key: '1m'..'1M'); null = N/A
  tpTf         String?
  slTf         String?
  // v1.97.0 — trailing exit (engine-managed, not a broker order): arms once
  // the position's unrealized profit ≥ trailArmPct % (measured from the
  // broker position's avg entry price), then tracks the best price since
  // arming and market-closes when price gives back trailGivePct % from that
  // peak. 'off' | 'pct' — only protects while the run is running; the
  // broker-side SL/TP bracket above stays as the catastrophic stop.
  trailMode    String    @default("off")
  trailArmPct  Float?
  trailGivePct Float?
  maxTradesDay Int       @default(3)
  rthOnly      Boolean   @default(true)
  flattenEod   Boolean   @default(true)
  // re-entry control (Task 70-c): cooldownMin = no new entries for N minutes
  // after the run's position closes (0 = off) · requireNewSignal = a signal may
  // only fire on a false→true edge vs the previously processed closed bar
  cooldownMin     Int     @default(0)
  requireNewSignal Boolean @default(false)
  // v2.5.0 — Market sentiment gate: before ANY entry the engine reads the
  // symbol's latest stored sentiment snapshot (SentimentScore) and blocks
  // entries that FIGHT the crowd — a BUY is refused while sentiment ≤ -0.30,
  // a SELL while sentiment ≥ +0.30. Stale snapshots (> 12h) pass through so
  // the gate degrades gracefully instead of bricking quiet symbols.
  sentimentGate Boolean   @default(false)
  // v2.10.0 — Market regime gate: while the US tape reads RISK_OFF (UVXY
  // above its 20-DMA, or QQQ below a falling 50-DMA) the engine blocks NEW
  // LONG entries on non-crypto runs; shorts/inverse setups stay live and
  // crypto is exempt (its own 24/7 tape). UNKNOWN/stale regime fails open.
  // Armed by the autopilot on every fleet run; standalone Algo runs default off.
  regimeGate   Boolean   @default(false)
  // v2.11.0 — Earnings gate: the one calendar event a backtest can never see.
  // While the symbol's next consensus report (Yahoo calendarEvents) sits
  // inside the 2-day pre-report window (through the report day itself), the
  // engine blocks NEW LONG entries — a report re-prices a stock in a single
  // gap. Shorts/inverse setups stay live, crypto is exempt (no earnings) and
  // a missing/failed date FAILS OPEN. Armed by the autopilot; standalone
  // Algo runs default off.
  earningsGate Boolean   @default(false)
  // 'running' | 'stopped'
  status       String    @default("running")
  state        Json?
  startedAt    DateTime  @default(now())
  stoppedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}

// Append-only engine journal: cycle notes, signal detection, order results,
// errors. Powers the live log feed in the Algo tab.
model AlgoLog {
  id        String   @id @default(cuid())
  runId     String
  userId    String
  level     String   @default("info") // info | signal | trade | error
  message   String
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
  @@index([userId, createdAt])
}

// Task 3-d — local bar cache for CRYPTO history only (crypto bars are
// immutable once closed; stock bars are NOT cached here because Alpaca stock
// responses are split-adjusted and the adjustment basis can change over time).
// time = unix seconds, bar OPEN time (same convention as src/lib/market-types).
// Composite PK makes saveBars an idempotent upsert (INSERT OR REPLACE).
model Bar {
  symbol String
  tf     String
  time   Int
  open   Float
  high   Float
  low    Float
  close  Float
  volume Float

  @@id([symbol, tf, time])
  @@index([symbol, tf])
}

// Task 90 — cached output of the "Recommended setups" sweep matrix. One row
// (fixed id) holds the newest full-catalog sweep results as JSON; the Backtest
// page reads it via GET /api/algo/recommendations and a refresh POST rewrites
// it. Falls back to the baked-in static list when absent.
model AlgoRecoCache {
  id          String   @id @default("algo-reco")
  generatedAt DateTime
  payload     String
  updatedAt   DateTime @updatedAt
}

// Grid Trading — a range grid bot: buy dips at lower grid levels, sell the
// lots as price climbs to the next level. The engine loop (grid-engine.ts)
// re-reads the row every cycle — the DB is the single source of truth and
// grids with status 'active' auto-resume after a server restart (same model
// as AlgoRun).
model GridTrade {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  // Task 89 — the Alpaca account this grid trades on, PINNED at start time
  // (grid start refuses live mode, so every row is 'paper'). Entries, TP
  // sells and guard closes always hit THIS account — a later Settings →
  // tradeMode flip never migrates a running grid (the old resolve-at-order-
  // time behavior could fire a paper grid's orders onto the live account,
  // or strand its position by closing against the wrong broker).
  mode        String    @default("paper") // 'paper' | 'live'
  // ---- range ----
  lowerPrice  Float
  upperPrice  Float
  gridCount   Int // number of grid levels (2..200)
  // 'arithmetic' (evenly spaced) | 'geometric' (equal ratio)
  spacing     String    @default("arithmetic")
  // ---- sizing ----
  qtyPerGrid  Float
  // ---- whole-grid guards (optional) ----
  maxSL       Float? // price falls here → close everything + stop (hard floor)
  maxTP       Float? // price rises here → close everything + stop (profit ceiling)
  // Task 10-a — how the guard values are expressed: 'price' = maxSL/maxTP are
  // absolute prices (must order strictly outside the range) · 'percent' =
  // maxSL/maxTP are percentages: slTrigger = lowerPrice × (1 − maxSL/100),
  // tpTrigger = upperPrice × (1 + maxTP/100) — resolved EVERY engine tick so a
  // later config edit (PUT /api/grid/[id]) re-arms the guards automatically.
  slBasis     String    @default("price")
  tpBasis     String    @default("price")
  // v1.96.0 — basis 'atr': maxSL/maxTP are ATR(14) multipliers (0.1–20) on
  // slTf/tpTf; guard triggers = range edge ∓ mult × ATR, re-resolved every
  // engine tick so the guard breathes with the instrument's volatility
  slTf        String?
  tpTf        String?
  // Task 10-g — grid direction: 'both' (classic: buy dips + sell rallies) |
  // 'buy' (ladder-accumulate: buy each level as price falls, no auto-sells) |
  // 'sell' (sell each level as price rises — on stocks Alpaca nets this against
  // held shares or shorts; engine tracks the sold lots inverted and a close
  // buys them back. Guards mirror: SL sits ABOVE upper, TP BELOW lower.)
  direction   String    @default("both")
  // when the grid stops (manual or guard), market-close open grid positions
  closeOnStop Boolean   @default(true)
  // 'active' | 'paused' | 'stopped' | 'error' — 'paused' (Task 18) is a SUSPENDED
  // grid: the engine tick queries status 'active' only, so a paused grid places
  // NO orders and evaluates NO guards; resume flips it back to 'active'.
  status      String    @default("active")
  stopReason  String?
  // ---- Task 18 — auto grid provenance ----
  // true when the Auto Grid watchlist scan created this grid
  auto        Boolean   @default(false)
  // the scan's plan snapshot: why it started (reason/score/regime metrics),
  // the backtest evidence and the end conditions — shown in the Grid tab
  autoPlan    Json?
  // planned end (auto preset): the engine stops the grid when now ≥ autoEndAt
  autoEndAt   DateTime?
  // engine-maintained cached stats (recomputable from fills)
  realizedPnl Float     @default(0)
  feePaid     Float     @default(0)
  // working memory: levels snapshot + open lots — survives restarts
  state       Json?
  startedAt   DateTime  @default(now())
  stoppedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

// One executed grid order (buy at a level, sell/TP of a lot, or a
// stop/guard close). Append-only, like StrategyFireLog.
model GridFill {
  id          String   @id @default(cuid())
  gridTradeId String
  userId      String
  levelIndex  Int
  side        String // 'buy' | 'sell'
  reason      String   @default("grid") // 'grid' | 'tp' | 'sl' | 'maxtp' | 'manual_close' | 'auto_end'
  price       Float
  qty         Float
  pnl         Float? // realized P&L on sells (vs the paired buy lot)
  fee         Float    @default(0)
  orderId     String?
  note        String?
  ts          DateTime @default(now())

  @@index([gridTradeId, ts])
  @@index([userId])
  // v2.11.3 — the 10s positions console filters {userId, orderId not null}
  // ordered by ts desc (was a full per-user scan + sort on every poll); also
  // index-backs any userId+ts windowing
  @@index([userId, ts])
}

// Task 18 — one Auto Grid watchlist scan ('scan' = analyze only, the report
// powers the dialog's preview) or 'start' run (grids actually created). The
// full per-symbol report (decision, reason, regime metrics, backtest evidence,
// chosen setup, end conditions) is persisted so the "why" survives reloads.
model GridAutoRun {
  id        String   @id @default(cuid())
  userId    String
  mode      String   @default("start") // 'scan' | 'start'
  watchlist String   // watchlist NAME at scan time (display)
  scanned   Int
  started   Int
  skipped   Int
  failed    Int      @default(0) // start attempts that errored
  report    Json     // GridAutoDecision[] — see src/lib/grid-auto.ts
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  // v2.11.3 — index-backed retention prune + the 14d sweep in /api/grid/auto
  @@index([createdAt])
}

// Task 9-j — per-install master secret store. The platform publish pipeline
// sanitizes secret lines out of .env; this row (created at boot when env is
// absent) keeps the install bootable while never using a publicly-known
// constant. Env (APP_ENCRYPTION_SECRET || AUTH_SECRET) always wins and is
// mirrored here so later sanitized boots resolve the SAME key.
model AppSecret {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Task 11-b — persistent fixed-window rate-limit buckets (brute-force guard
// that SURVIVES restarts; the old in-process Map was wiped on every reboot).
// Written by src/lib/rate-limit.ts; expired rows are pruned lazily (a small
// random slice of calls deleteMany everything already past its window).
// Key format: '<scope>:<identity>' — e.g. `loginv:203.0.113.9:trader`,
// `grid:clxuser123`, `test:rl:…` (tests use the same table and clean up).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// v2.4.0 — Nebula Autopilot (智慧體): the FSD-style fleet manager. One row per
// autonomous campaign: it scans the 100-stock high-VOL US universe (+ crypto
// majors), backtests every symbol across the algo catalog, tunes the winners
// on an optimizer grid, ranks by the Calmar-style score, sizes each slot
// against the account's BUYING POWER and (on engage) spawns real AlgoRun
// engines. Status machine:
//   scanning → tuning → ranking → budget → ready → engaged → stopped | error
// candidates/selected/budget/settings/stats are JSON payloads (same pattern as
// GridAutoRun.report) — the ranking table IS the session document.
model AgentSession {
  id         String   @id @default(cuid())
  userId     String
  status     String   @default("scanning")
  phase      String   @default("")
  progress   Float    @default(0)
  mode       String   @default("paper")
  settings   Json
  universe   Json?
  candidates Json?
  selected   Json?
  budget     Json?
  stats      Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

// Append-only agent brain feed — every scan/tune/rank/budget/trade decision
// lands here so the tab can replay exactly WHAT the autopilot was thinking.
model AgentEvent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  level     String   @default("info")
  message   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// v2.5.0 — MARKET SENTIMENT ENGINE. Free news ingestion (Google News RSS —
// the only external feed reachable from this box; Yahoo RSS is dead 404 and
// Reddit/StockTwits hard-403) + NLP sentiment scoring (LLM finance scorer as
// the FinBERT-equivalent engine, with an offline finance lexicon fallback) +
// per-symbol historical sentiment storage for the sentiment↔price IC / Rank-IC
// evaluation. One row per (symbol, article) — the (symbol,url) unique key makes
// ingestion idempotent across scans.
model SentimentHeadline {
  id          String    @id @default(cuid())
  symbol      String
  source      String    @default("google_news_rss")
  publisher   String?
  title       String
  url         String
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  // null until scored — the scorer backfills pending rows after each ingest
  label       String?   // 'positive' | 'negative' | 'neutral'
  score       Float?    // -1..1 (label collapsed to a signed value)
  confidence  Float?    // 0..1 — LLM self-reported / lexicon match strength
  engine      String?   // 'llm-finance-v1' | 'lexicon-finance-v1'

  @@unique([symbol, url])
  @@index([symbol, publishedAt])
  @@index([symbol, score])
  @@index([fetchedAt])
}

// Hourly sentiment snapshot per symbol — the aggregate the gates, the algo
// engine and the autopilot ranking actually read. `score` is the
// recency×confidence-weighted mean headline score (-1..1); momentum is the
// delta vs the previous stored bucket. Buckets are hourly ISO strings so the
// (symbol,bucket) unique key is idempotent for repeated scans.
model SentimentScore {
  id         String    @id @default(cuid())
  symbol     String
  bucket     String    // '2026-11-01T17:00' hourly bucket (UTC)
  asOf       DateTime
  score      Float
  bull       Int       @default(0)
  bear       Int       @default(0)
  neutral    Int       @default(0)
  headlines  Int       @default(0)
  momentum   Float?
  engine     String    @default("llm-finance-v1")
  createdAt  DateTime  @default(now())

  @@unique([symbol, bucket])
  @@index([symbol, asOf])
  @@index([asOf])
}

// v2.8.0 — persistent FSD scan-result store. One row per (symbol, lane):
// the best sweep row of the last full scan + its tuning outcome. The scan
// pipeline reuses fresh rows (< SCAN_CACHE_FRESH_MS) verbatim, so reruns
// after a crash/restart resume where the previous run stopped and daily
// rescans cost seconds instead of the full bars+sweep+tune tour. Rows with
// strategy='none' are NEGATIVE results (swept clean) — cached too so reruns
// skip those symbols as well. `engine` is the pipeline fingerprint: bump it
// whenever sweep behavior changes to invalidate the whole store at once.
// Tiny by design (~250 rows) — the disk hog is NOT this table (see the
// /api/agent/storage route for what actually eats the volume).
model AgentScanCache {
  symbol        String
  lane          String // 'day' | 'swing'
  engine        String // pipeline fingerprint, e.g. 'v1'
  isCrypto      Boolean
  tf            String
  strategy      String // AlgoStrategyId, or 'none' for a swept-clean symbol
  params        Json?
  metrics       Json? // BacktestMetrics of the best sweep row
  oos           Json? // SweepOos of the best sweep row
  score         Float?
  boundary      Boolean @default(false)
  bars          Int     @default(0)
  coveredDays   Int     @default(0)
  tunedStrategy String?
  tunedParams   Json?
  tunedTpPct    Float?
  tunedSlPct    Float?
  tunedScore    Float? // Calmar score of the tuned best (replays the beat-the-sweep decision)
  tunedMetrics  Json? // BacktestMetrics of the tuned best
  computedAt    DateTime
  updatedAt     DateTime @updatedAt

  @@id([symbol, lane])
}

// v2.12.22 — AI 護倉 (portfolio steward) audit trail: one row per steward
// action/observation — position TP/SL amend, pending-order amend/cancel,
// close, hold note, review lesson, cycle summary, error. The engine prunes
// in the same POST that writes: rows older than the user's retention window
// (purgeDays, clamped 3–60) are deleted, plus a hard per-user cap keeps this
// table tiny no matter what.
model AiStewardEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String // 'position' | 'order' | 'lesson' | 'cycle' | 'error'
  action    String // 'amend_tp' | 'amend_sl' | 'amend_entry' | 'cancel' | 'close' | 'hold' | 'keep' | 'summary' | 'lesson'
  symbol    String?
  status    String // 'executed' | 'skipped' | 'failed' | 'dry_run' | 'stored'
  detail    String // human-readable verdict reason (server-bounded)
  payload   Json? // {from,to,confidence,reason,orderId,...} audit detail
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// v2.12.26 — permanent steward memory. The ask: "need to remember
// 記取的教訓（餵回每輪檢視） permanently" — distilled lessons must NOT be
// purged with the audit trail (AiStewardEvent rows are bounded by purgeDays +
// a hard cap, so lessons used to vanish after a few days). One row per
// (user, lesson text); re-observed lessons bump lastSeenAt so reinforced
// insights stay fresh; the table is capped generously (300) — oldest
// never-reinforced rows fall off first, everything else lives forever.
model AiStewardLesson {
  id         String   @id @default(cuid())
  userId     String
  text       String
  createdAt  DateTime @default(now()) // first learned
  lastSeenAt DateTime @default(now()) // last reinforced (bumped on re-observation)

  @@unique([userId, text])
  @@index([userId, lastSeenAt])
}

// v2.12.24 — account-level enabled/config state for the two client-run AI
// engines (AI 自動交易 scanner + AI 護倉 steward), so every signed-in computer
// sees the same toggles (the engines used to be localStorage-only — device 2
// never saw what device 1 switched on). One row per (user, kind).
// runnerId/runnerName/heartbeatAt elect ONE browser as the engine runner:
// other devices show 「其他裝置運行中」 and stay idle; a stale heartbeat (>75s)
// or a pagehide release frees the slot for automatic takeover. The election
// update is a guarded updateMany so two devices claiming a dead slot
// simultaneously resolve to exactly one winner server-side.
model AiOpsState {
  id          String    @id @default(cuid())
  userId      String
  kind        String // 'auto-trade' | 'steward'
  enabled     Boolean   @default(false)
  config      Json? // sanitized engine config (enabled lives in the column, stripped from here)
  runnerId    String? // deviceId:tabNonce of the elected browser
  runnerName  String? // friendly device name for the honest UI
  heartbeatAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, kind])
  @@index([userId])
}

// v2.12.33 — post-hoc attribution for the AI Trade auto-trader. Every
// non-flat scan verdict is persisted (fired / dry-run / gated + the gate
// note + the regime & earnings context it was decided under); ~24h later a
// reconciliation pass marks the outcome (24h mark-to-market P&L%) and
// distills a 「自動交易覆盤」 line into the PERMANENT AiStewardLesson memory —
// so "which evidence combinations actually win" is fed back into every
// future review instead of evaporating with the scan logs.
model AiTradeVerdict {
  id         String    @id @default(cuid())
  userId     String
  symbol     String
  direction  String // 'long' | 'short'
  confidence Int
  entry      Float?
  stop       Float?
  target     Float?
  rr         Float?
  regime     String? // RISK_ON | NEUTRAL | RISK_OFF | UNKNOWN at decision time
  earnings   String? // 'block' | '<daysAway>' | 'unknown'
  status     String // 'fired' | 'dry-run' | 'gated'
  gateNote   String? // reject reason when status = 'gated'
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  outcome    String? // 'win' | 'loss' | 'flat' (24h mark-to-market)
  pnlPct     Float?

  @@index([userId, resolvedAt])
  @@index([userId, createdAt])
}

// v2.12.37 — AI TRADE PLAN LEDGER (React > Respond > Review). The entry
// protocol no longer converts a confident verdict into an immediate market
// order. Instead the model outputs CONDITIONAL PLANS (buy/sell trigger +
// corresponding TP/SL), the terminal persists them WAITING, and a reactor
// loop watches the market: price rising through a buy trigger (market went
// up) FOLLOWS the plan; price falling through the plan's stop first
// INVALIDATES it (market went against — stand aside); 48h without a
// resolution EXPIRES it. Every closed plan gets a 24h review pass — was the
// wait right (good-wait: price kept falling / would have stopped out) or did
// discipline cost the move (missed-run: price crossed the trigger after the
// plan died) — distilled into the permanent lesson memory so future planning
// learns from what waiting actually achieved.
model AiTradePlan {
  id         String    @id @default(cuid())
  userId     String
  symbol     String
  side       String // 'buy' (reacts to UP-move through trigger) | 'sell' (reacts to DOWN-move)
  bias       String // model lean when planned: 'long' | 'short' | 'flat'
  confidence Int
  trigger    Float
  tp         Float
  sl         Float
  rr         Float // terminal-computed at plan time (never trusted from the model)
  refPrice   Float // last close when the plan was written — the 距觸發% anchor
  reason     String?
  regime     String? // RISK_ON | NEUTRAL | RISK_OFF | UNKNOWN at plan time
  earnings   String? // 'block' | '<daysAway>' | 'unknown'
  mode       String // 'paper' | 'live' at plan time
  status     String // WAITING | EXECUTED | INVALIDATED | EXPIRED | GATED | CANCELLED | SUPERSEDED
  statusNote String?
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  resolvedAt DateTime? // review pass done (24h after close)
  outcome    String? // 'missed-run' | 'good-wait' | 'neutral'
  pnlPct     Float?

  @@index([userId, status])
  @@index([userId, symbol, side, status])
  @@index([userId, closedAt])
}

// v2.12.34 — AUTO WATCHLIST: the AI auto-trader's candidate pool, screened
// from the whole US-listed equity universe instead of only the user's hand
//picked watchlist. One row per (user, symbol), ≤ 50 rows per user, refreshed
// whenever the screener route runs (GET /api/market/screener — server caches
// the heavy market-wide compute 15 min across users, persistence here is
// per-account best-effort). Metrics ride the row so the panel and the model
// pack can show WHY each name made the cut without refetching anything.
model ScreenerPick {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  name      String? // company/ETF name from the Alpaca asset record
  rank      Int // 1 = best score
  score     Float // 0-100 composite percentile (ATR 40% / $vol 30% / relVol 15% / range 15%)
  price     Float?
  atrPct    Float? // ATR14 as % of close (volatility factor)
  rangePct  Float? // (dayHigh-dayLow)/prevClose (intraday amplitude)
  dollarVol Float? // close × day volume (liquidity factor)
  relVol    Float? // today volume ÷ 20-day average
  chgPct    Float? // today % change
  ret20     Float? // 20-session return (momentum context, reported not scored)
  kind      String? // 'stock' | 'etf' (name-heuristic)
  source    String // 'real' | 'sim' (sim = no Alpaca keys — static universe, metrics unknown)
  capturedAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId, rank])
}
